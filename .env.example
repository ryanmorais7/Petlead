# Copie este arquivo para .env.local e preencha os valores.
# .env.local nunca deve ser commitado.

# ---------------------------------------------------------------------------
# Banco de dados (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Connection string "pooled" do painel do Neon.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# URL pública do sistema (sem barra no final).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# WhatsApp Business Platform / Cloud API
# ---------------------------------------------------------------------------
# Todas opcionais: sem elas o sistema funciona, com o envio desabilitado.
# Passo a passo em docs/whatsapp-setup.md.
#
# Recebimento (webhook)
# Texto livre definido por você; o mesmo valor é informado no painel da Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret do app da Meta. Valida a assinatura de cada webhook recebido.
WHATSAPP_APP_SECRET=
#
# Envio
# Token de acesso permanente de um usuário de sistema.
WHATSAPP_ACCESS_TOKEN=
# ID do número de telefone (não é o número em si).
WHATSAPP_PHONE_NUMBER_ID=
# Versão da Graph API, ex.: v23.0. Use a versão exibida no painel do app.
WHATSAPP_GRAPH_API_VERSION=
#
# Referência
# ID da conta WhatsApp Business. Ainda não é usado pelo código.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Gerador de mensagens (resumo, diagnóstico e sugestões)
# ---------------------------------------------------------------------------
# Opcional: sem a chave o sistema funciona, e os botões de gerar mensagem
# avisam que o gerador não está conectado. Passo a passo em docs/ai-setup.md.
#
# Chave de API do provedor.
AI_API_KEY=
# Provedor. Hoje só "anthropic" (usado quando fica vazio).
AI_PROVIDER=
# Modelo. Vazio usa o padrão do provedor (claude-opus-5-5).
AI_MODEL=

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
# Segredo usado para assinar a sessão (mínimo de 32 caracteres). Sem ele ninguém
# consegue entrar. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
