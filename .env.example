# Copie este arquivo para .env.local e preencha os valores.
# .env.local nunca deve ser commitado.

# ---------------------------------------------------------------------------
# Banco de dados (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Connection string "pooled" do painel do Neon.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# URL pública do sistema (sem barra no final).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# WhatsApp Business Platform / Cloud API  (etapa 2 - ainda não utilizado)
# ---------------------------------------------------------------------------
# Token de acesso permanente do usuário de sistema.
WHATSAPP_ACCESS_TOKEN=
# ID do número de telefone no WhatsApp Business.
WHATSAPP_PHONE_NUMBER_ID=
# ID da conta WhatsApp Business.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret do app da Meta, usado para validar a assinatura dos webhooks.
WHATSAPP_APP_SECRET=
# Texto livre definido por você, informado no painel da Meta ao cadastrar o webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Versão da Graph API.
WHATSAPP_GRAPH_API_VERSION=

# ---------------------------------------------------------------------------
# Provider de sugestões de mensagem  (etapa 3 - ainda não utilizado)
# ---------------------------------------------------------------------------
# Identificador do provider configurado em lib/ai/provider.ts.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ---------------------------------------------------------------------------
# Autenticação  (etapa futura)
# ---------------------------------------------------------------------------
# Segredo usado para assinar a sessão. Gere com: openssl rand -base64 32
AUTH_SECRET=
